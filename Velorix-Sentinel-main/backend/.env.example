# --- Database -------------------------------------------------------------
# Supabase uses normal PostgreSQL/JDBC credentials. In Render, set the
# SUPABASE_* variables from the Supabase session pooler connection details.
# Keep DB_* for local PostgreSQL or another PostgreSQL provider.
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=change-me

DB_URL=jdbc:postgresql://localhost:5432/velorix_sentinel
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Schema is owned by migrations. Use `update` only for local scratch work.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# --- Security -------------------------------------------------------------
# Base64 encoded, >= 64 bytes. Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_ISSUER=velorix-sentinel
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P7D

# --- Application ----------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:8080
EMAIL_VERIFICATION_EXPIRATION=PT24H
PASSWORD_RESET_EXPIRATION=PT30M
SHORT_LIVED_REFRESH_EXPIRATION=PT12H

# --- HTTP -----------------------------------------------------------------
# The Vite dev server occupies 8080; the API listens on 8081 locally.
# Local development uses 8081. The Docker image defaults to Render's 10000.
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL_APP=DEBUG
CAPTURE_STORAGE_LOCATION=./data/captures
CAPTURE_MAX_FILE_SIZE=100MB
