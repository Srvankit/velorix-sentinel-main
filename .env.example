# ==============================================================================
# Velorix Sentinel Frontend Environment Variables
# ==============================================================================
# REQUIRED: Base URL for backend API communication.
# In production / preview deployments, this MUST be explicitly configured (e.g. in Netlify Site Settings).
# If omitted in production, the application will fail fast and display an API configuration warning
# rather than silently connecting to a production environment.
#
# Development (local backend default):
#   VITE_API_BASE_URL=http://localhost:8080/api
#
# Production (Render deployed backend):
#   VITE_API_BASE_URL=https://velorix-sentinel-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api
