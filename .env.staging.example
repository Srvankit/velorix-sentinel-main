# ==============================================================================
# Velorix Sentinel Frontend Staging Environment Variables (.env.staging.example)
# ==============================================================================
# Copy this file to .env.staging or configure these variables in the Netlify Staging
# Site Settings under "Build & deploy" > "Environment variables".
#
# NOTE: In TanStack Start / Vite, all VITE_* variables are evaluated and baked
# into the client bundle at BUILD TIME. If you change this value, you must trigger
# a new deploy/build in Netlify for changes to take effect.
# ==============================================================================

# [MANDATORY IN STAGING]
# The absolute HTTPS origin and context path of the staging Spring Boot backend.
# Staging frontend will reject unconfigured builds and display a setup warning
# rather than silently connecting to localhost or falling back to production.
# Example: https://velorix-sentinel-backend-staging.onrender.com/api
VITE_API_BASE_URL=https://<STAGING_RENDER_SERVICE_NAME>.onrender.com/api

# [OPTIONAL IN STAGING]
# Feedback email address displayed across the footer, sidebar, and error screens.
# If unset or empty, the in-app feedback mailto links are cleanly hidden.
VITE_FEEDBACK_EMAIL=beta-feedback@example.com
