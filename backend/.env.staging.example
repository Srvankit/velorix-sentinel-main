# ==============================================================================
# Velorix Sentinel Backend Staging Environment Variables (.env.staging.example)
# ==============================================================================
# Configure these environment variables in the Render Staging Web Service dashboard
# ("Environment" tab) or in a local backend test environment.
#
# DESIGN DECISION: Staging mirrors production by running with SPRING_PROFILES_ACTIVE=prod
# so that ProductionProfileValidator enforces all production security guardrails.
# Staging MUST NOT share any database, S3 bucket, JWT secret, or OAuth app with production!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Runtime & Active Profiles
# ------------------------------------------------------------------------------
# [MANDATORY] Must be set to 'prod' in staging to activate application-prod.yml
# and trigger strict production fail-fast validations.
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. Database (Supabase PostgreSQL Session Pooler)
# ------------------------------------------------------------------------------
# [MANDATORY] Primary: SUPABASE_DB_URL (Fallback alias: DB_URL)
# CRITICAL: Use the Supabase SESSION pooler (port 5432 or 6543 in session mode).
# Do NOT use the transaction pooler (port 6543 transaction mode), as JDBC prepared statements will break.
# Always check your Supabase Dashboard under "Project Settings" > "Database" > "Connection Pooling".
# Pooler username format is: postgres.<project-ref>
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# [MANDATORY] Primary: SUPABASE_DB_USERNAME (Fallback alias: DB_USERNAME)
# Format: postgres.<project-ref> (verify against your Supabase Connect modal)
SUPABASE_DB_USERNAME=postgres.<STAGING_PROJECT_REF>

# [MANDATORY] [SECRET] Primary: SUPABASE_DB_PASSWORD (Fallback alias: DB_PASSWORD)
# Staging database password set during Supabase project creation. Insecure defaults will be rejected.
SUPABASE_DB_PASSWORD=<GENERATE_STRONG_STAGING_DB_PASSWORD>

# ------------------------------------------------------------------------------
# 3. JWT Authentication & Token Security
# ------------------------------------------------------------------------------
# [MANDATORY] [SECRET] Cryptographically random Base64-encoded secret of at least 64 bytes (512 bits).
# Linux/macOS: openssl rand -base64 64 | tr -d '\n'
# Windows PowerShell: see docs/STAGING_SETUP.md for the RandomNumberGenerator snippet.
JWT_SECRET=<GENERATE_ME_BASE64_64_BYTES>

# [OPTIONAL] JWT issuer claim. Default: velorix-sentinel
JWT_ISSUER=velorix-sentinel-staging

# [OPTIONAL] Access token TTL. Default: PT15M (15 minutes)
JWT_ACCESS_TOKEN_EXPIRATION=PT15M

# [OPTIONAL] Refresh token TTL. Default: P7D (7 days)
JWT_REFRESH_TOKEN_EXPIRATION=P7D

# ------------------------------------------------------------------------------
# 4. Web Console URL & CORS Allowlist
# ------------------------------------------------------------------------------
# [MANDATORY] Public HTTPS URL of the Netlify staging frontend.
# Required for generating email verification and password reset links. Must start with https://.
FRONTEND_BASE_URL=https://<STAGING_NETLIFY_SITE_NAME>.netlify.app

# [MANDATORY] Strict CORS allowed origins. Must be an exact HTTPS origin matching FRONTEND_BASE_URL.
# Disallows wildcards (*, *.netlify.app).
CORS_ALLOWED_ORIGINS=https://<STAGING_NETLIFY_SITE_NAME>.netlify.app

# ------------------------------------------------------------------------------
# 5. Durable Object Storage (Supabase Storage / S3-compatible)
# ------------------------------------------------------------------------------
# [MANDATORY IN STAGING] Primary: VELORIX_STORAGE_PROVIDER
# Must be set to 's3' in staging. 'filesystem' is rejected in prod profile unless emergency override is set.
VELORIX_STORAGE_PROVIDER=s3

# [MANDATORY IN STAGING] Primary: S3_BUCKET_NAME (Fallback alias: SUPABASE_STORAGE_BUCKET)
# The private staging storage bucket created in Supabase Dashboard.
S3_BUCKET_NAME=velorix-captures-staging

# [MANDATORY IN STAGING] Primary: AWS_REGION (Fallback alias: S3_REGION)
# Region of your Supabase project (e.g. us-east-1, eu-central-1).
AWS_REGION=us-east-1

# [MANDATORY FOR SUPABASE] Primary: S3_ENDPOINT (Fallback alias: SUPABASE_STORAGE_S3_ENDPOINT)
# The S3-compatible API endpoint found in Supabase Dashboard > Project Settings > Storage > S3 settings.
# Format: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=https://<STAGING_PROJECT_REF>.supabase.co/storage/v1/s3

# [MANDATORY FOR SUPABASE] [SECRET] Primary: AWS_ACCESS_KEY_ID (Fallback alias: S3_ACCESS_KEY)
# S3 Access Key ID generated in Supabase Dashboard > Storage > S3 Access Keys.
AWS_ACCESS_KEY_ID=<STAGING_S3_ACCESS_KEY_ID>

# [MANDATORY FOR SUPABASE] [SECRET] Primary: AWS_SECRET_ACCESS_KEY (Fallback alias: S3_SECRET_KEY)
# S3 Secret Key generated in Supabase Dashboard > Storage > S3 Access Keys.
AWS_SECRET_ACCESS_KEY=<STAGING_S3_SECRET_KEY>

# [OPTIONAL] Path-style access. Default: true (required for Supabase Storage and MinIO).
S3_PATH_STYLE_ACCESS=true

# [OPTIONAL] Storage key prefix. Default: captures/
S3_PREFIX=captures/

# ------------------------------------------------------------------------------
# 6. Transactional Email Delivery (SMTP)
# ------------------------------------------------------------------------------
# [MANDATORY FOR REAL EMAILS] SMTP server hostname (e.g. smtp.sendgrid.net, smtp.mailgun.org, smtp.postmarkapp.com).
# If blank, startup fails unless ALLOW_LOGGING_EMAIL_FALLBACK=true emergency override is set.
SMTP_HOST=smtp.sendgrid.net

# [OPTIONAL] SMTP port. Default: 587 (STARTTLS)
SMTP_PORT=587

# [MANDATORY IF SMTP_HOST IS SET] SMTP authentication username.
SMTP_USERNAME=<STAGING_SMTP_USERNAME>

# [MANDATORY IF SMTP_HOST IS SET] [SECRET] SMTP authentication password / API key.
SMTP_PASSWORD=<STAGING_SMTP_PASSWORD>

# [OPTIONAL] From address for outgoing transactional emails. Must match verified domain/sender in email provider.
MAIL_FROM=notifications@<VERIFIED_DOMAIN_OR_SANDBOX>

# [OPTIONAL] Sender display name. Default: Velorix Sentinel
MAIL_FROM_NAME=Velorix Sentinel (Staging)

# ------------------------------------------------------------------------------
# 7. OAuth2 Social Authentication (Google & GitHub)
# ------------------------------------------------------------------------------
# Dedicated staging OAuth applications. Do NOT reuse production client credentials!
# Redirect URI to configure in consoles:
#   Google: https://<STAGING_RENDER_HOST>/login/oauth2/code/google
#   GitHub: https://<STAGING_RENDER_HOST>/login/oauth2/code/github

# [OPTIONAL IF GOOGLE OAUTH NOT USED] Google OAuth Client ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=<STAGING_GOOGLE_CLIENT_ID>

# [OPTIONAL IF GOOGLE OAUTH NOT USED] [SECRET] Google OAuth Client Secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=<STAGING_GOOGLE_CLIENT_SECRET>

# [OPTIONAL IF GITHUB OAUTH NOT USED] GitHub OAuth Client ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=<STAGING_GITHUB_CLIENT_ID>

# [OPTIONAL IF GITHUB OAUTH NOT USED] [SECRET] GitHub OAuth Client Secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=<STAGING_GITHUB_CLIENT_SECRET>

# ------------------------------------------------------------------------------
# 8. Emergency Validation Overrides (USE FOR EMERGENCIES ONLY!)
# ------------------------------------------------------------------------------
# [OPTIONAL] Allows backend to boot in prod profile with logging email fallback when SMTP_HOST is blank.
# WARNING: When true, verification emails and password reset links are NOT delivered to users!
ALLOW_LOGGING_EMAIL_FALLBACK=false

# [OPTIONAL] Allows backend to boot in prod profile with local filesystem storage.
# WARNING: When true, uploaded captures stored on container ephemeral storage are WIPED on restart!
ALLOW_FILESYSTEM_STORAGE=false

# ------------------------------------------------------------------------------
# 9. Server Port & Network Proxying
# ------------------------------------------------------------------------------
# [OPTIONAL] Listen port. In Render container, defaults to 10000.
PORT=10000

# [OPTIONAL] Trusted proxy IPs / CIDR ranges for X-Forwarded-For resolution. Default empty (fail-closed).
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# 10. Observability, Swagger & Health Checks
# ------------------------------------------------------------------------------
# [OPTIONAL] Swagger UI / OpenAPI gating. Default: false in production profile.
SWAGGER_ENABLED=false

# [OPTIONAL] Application log level. Default: INFO in production profile.
LOG_LEVEL_APP=INFO

# [OPTIONAL] Structured log formatting. Set to 'json' in production for structured cloud log parsing.
LOG_STRUCTURED_FORMAT=ecs

# [OPTIONAL] Database health check indicator under /actuator/health. Default: true
MANAGEMENT_HEALTH_DB_ENABLED=true

# ------------------------------------------------------------------------------
# 11. Internal Tuning Knobs (Present in code, flagged as omitted from audit summary table)
# ------------------------------------------------------------------------------
# The following variables exist as Spring placeholders in application.yml.
# They have safe production defaults and typically do not require staging overrides:
#
# --- Database Connection Pool ---
# DB_POOL_SIZE=10
# DB_POOL_MIN_IDLE=2
# DB_CONNECTION_TIMEOUT=10000
# DB_VALIDATION_TIMEOUT=5000
# DB_INITIALIZATION_FAIL_TIMEOUT=10000
#
# --- Flyway & Schema ---
# FLYWAY_ENABLED=true
# FLYWAY_CONNECT_RETRIES=1
# FLYWAY_CONNECT_RETRIES_INTERVAL=1
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# JPA_SQL_COMMENTS=false
#
# --- Storage Quotas & Limits ---
# CAPTURE_MAX_FILE_SIZE=100MB
# CAPTURE_MAX_FILES_PER_USER=10
# CAPTURE_MAX_STORAGE_PER_USER=500MB
# CAPTURE_STORAGE_LOCATION=./data/captures
# MAX_UPLOAD_FILE_SIZE=100MB
# MAX_UPLOAD_REQUEST_SIZE=105MB
#
# --- Threat Detection & Inspection Engine Tuning ---
# DETECTION_ENGINE_VERSION=detect-1.0.0
# DETECTION_BATCH_SIZE=500
# DETECTION_STREAM_CHUNK_SIZE=10000
# DETECTION_MAX_FINDINGS_PER_RULE=200
# DETECTION_MAX_SAMPLE_FRAMES=20
# DETECTION_MAX_TRACKED_KEYS=200000
# DETECTION_DISABLED_RULES=
# INSPECTION_REAPER_INTERVAL=60000
# INSPECTION_REAPER_INITIAL_DELAY=30000
# INSPECTION_MAX_DURATION=PT15M
#
# --- Token Expiration Durations ---
# EMAIL_VERIFICATION_EXPIRATION=PT24H
# PASSWORD_RESET_EXPIRATION=PT30M
# SHORT_LIVED_REFRESH_EXPIRATION=PT12H
#
# --- Data Retention Cleanup Schedules ---
# SCHEDULING_ENABLED=true
# RETENTION_ENABLED=true
# RETENTION_CRON=0 0 3 * * *
# RETENTION_ZONE=UTC
# RETENTION_BATCH_SIZE=1000
# RETENTION_REFRESH_TOKENS=P30D
# RETENTION_VERIFICATION_TOKENS=P7D
# RETENTION_ACTIVITY_LOGS=P90D
# RETENTION_SOFT_DELETED_FILES=P30D
#
# --- Rate Limiting Thresholds ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_IP_CAPACITY=5
# RATE_LIMIT_LOGIN_IP_DURATION=PT1M
# RATE_LIMIT_LOGIN_EMAIL_CAPACITY=10
# RATE_LIMIT_LOGIN_EMAIL_DURATION=PT1M
# RATE_LIMIT_REGISTER_IP_CAPACITY=3
# RATE_LIMIT_REGISTER_IP_DURATION=PT1H
# RATE_LIMIT_FORGOT_PASSWORD_CAPACITY=3
# RATE_LIMIT_FORGOT_PASSWORD_DURATION=PT15M
# RATE_LIMIT_FILE_UPLOAD_CAPACITY=10
# RATE_LIMIT_FILE_UPLOAD_DURATION=PT1H
# RATE_LIMIT_GENERAL_API_CAPACITY=120
# RATE_LIMIT_GENERAL_API_DURATION=PT1M
# RATE_LIMIT_MAX_BUCKETS=50000
#
# --- SMTP Low-Level Properties ---
# SMTP_AUTH=true
# SMTP_STARTTLS_ENABLE=true
# SMTP_STARTTLS_REQUIRED=true
# SMTP_CONNECTION_TIMEOUT=5000
# SMTP_READ_TIMEOUT=5000
# SMTP_WRITE_TIMEOUT=5000
#
# --- Hibernate Logging ---
# LOG_LEVEL_HIBERNATE_SQL=INFO
# LOG_LEVEL_HIBERNATE_BIND=INFO
#
# --- Closed Beta Invite-Only Gate ---
# When true, new user registration (both password & OAuth) is restricted to allowed emails.
# Existing user accounts are never locked out. Case-insensitive and trimmed.
# Example: tester1@example.com, tester2@example.com, @partner.org
BETA_INVITE_ONLY=true
BETA_ALLOWED_EMAILS=tester1@example.com, @example.com
